<Window x:Class="SpaceInvadersWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Space Invaders" Width="640" Height="620"
        ResizeMode="NoResize" Background="Black"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
    <DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top"
                   Foreground="White" FontSize="16" Margin="8" />
        <Canvas x:Name="Field" Width="600" Height="500"
                Background="#101018" ClipToBounds="True"
                HorizontalAlignment="Center" VerticalAlignment="Top" />
    </DockPanel>
</Window>
